# ==============================================================================
# Dockerfile para API NestJS (Desenvolvimento Local / Hot-Reload)
# ==============================================================================
FROM node:22-alpine

WORKDIR /app

# Instala todas as dependências (inclusive devDependencies)
COPY package*.json ./
RUN npm install

# Copia código e configurações base
COPY . .

EXPOSE 3000 9229

CMD ["npm", "run", "start:debug"]
