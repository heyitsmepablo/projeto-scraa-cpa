# ==============================================================================
# SCRAA-CPA - Instância Produção (docker-compose.yml)
# ==============================================================================

# Identificador do projeto (namespace isolado de containers, redes e volumes)
COMPOSE_PROJECT_NAME=prod-projeto-scraa-cpa

# Banco de Dados PostgreSQL 18
POSTGRES_DB=scraa_prod
POSTGRES_USER=scraa_prod_user
POSTGRES_PASSWORD=prod_super_secure_password_789
DATABASE_URL=postgresql://scraa_prod_user:prod_super_secure_password_789@database:5432/scraa_prod

# Portas no Host para Produção
DB_PORT=5432
API_PORT=3000
WEB_PORT=80
PGADMIN_PORT=8080

# pgAdmin (Profile: tools)
PGADMIN_DEFAULT_EMAIL=admin-prod@scraa.local
PGADMIN_DEFAULT_PASSWORD=admin_prod_pass

# Scripts ETL
DATASUS_UFS=SP,RJ,MG,BA,AM
FTP_HOST=ftp2.datasus.gov.br
FTP_DIR=/pub/sistemas/tup/downloads/
FTP_TIMEOUT=30
SCHEDULE_HOUR=3
SCHEDULE_MINUTE=0

# Log
LOG_LEVEL=WARN
