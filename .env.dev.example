# ==============================================================================
# SCRAA-CPA - Ambiente de Desenvolvimento Local (docker-compose.dev.yml)
# ==============================================================================

# Identificador do projeto dev
DEV_COMPOSE_PROJECT_NAME=projeto-scraa-dev

# Credenciais do PostgreSQL Local
POSTGRES_DB=scraa_dev
POSTGRES_USER=scraa
POSTGRES_PASSWORD=scraa_secret_dev
DATABASE_URL=postgresql://scraa:scraa_secret_dev@localhost:5432/scraa_dev

# Portas no Host para Dev
DEV_DB_PORT=5432
DEV_API_PORT=3000
DEV_WEB_PORT=4200
DEV_DEBUG_PORT=9229
DEV_PGADMIN_PORT=8080

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@scraa.local
PGADMIN_DEFAULT_PASSWORD=admin

# Scripts ETL
DATASUS_UFS=SP,RJ,MG,BA,AM
FTP_HOST=ftp2.datasus.gov.br
FTP_DIR=/pub/sistemas/tup/downloads/
FTP_TIMEOUT=30
SCHEDULE_HOUR=0
SCHEDULE_MINUTE=0

# Log
LOG_LEVEL=DEBUG
