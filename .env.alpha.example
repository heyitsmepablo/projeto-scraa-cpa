# ==============================================================================
# SCRAA-CPA - Instância Alpha (docker-compose.yml)
# ==============================================================================

# Identificador do projeto (namespace isolado de containers, redes e volumes)
COMPOSE_PROJECT_NAME=alpha-projeto-scraa-cpa

# Banco de Dados PostgreSQL 18
POSTGRES_DB=scraa_alpha
POSTGRES_USER=scraa_alpha_user
POSTGRES_PASSWORD=alpha_secure_password_123
DATABASE_URL=postgresql://scraa_alpha_user:alpha_secure_password_123@database:5432/scraa_alpha

# Portas no Host para Instância Alpha
DB_PORT=5433
API_PORT=3001
WEB_PORT=8081
PGADMIN_PORT=8085

# pgAdmin (Profile: tools)
PGADMIN_DEFAULT_EMAIL=admin-alpha@scraa.local
PGADMIN_DEFAULT_PASSWORD=admin_alpha_pass

# Scripts ETL
DATASUS_UFS=SP,RJ,MG,BA,AM
FTP_HOST=ftp2.datasus.gov.br
FTP_DIR=/pub/sistemas/tup/downloads/
FTP_TIMEOUT=30
SCHEDULE_HOUR=1
SCHEDULE_MINUTE=0

# Log
LOG_LEVEL=INFO
