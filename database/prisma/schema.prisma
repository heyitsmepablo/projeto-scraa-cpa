model SigtapProcedimento {
  coProcedimento     String    @id @map("co_procedimento") @db.VarChar(10)
  noProcedimento     String    @map("no_procedimento") @db.VarChar(250)
  tpComplexidade     String    @map("tp_complexidade") @db.Char(1)
  tpSexo             String    @map("tp_sexo") @db.Char(1)
  qtMaximaExecucao   Int       @map("qt_maxima_execucao")
  qtDiasPermanencia  Int       @map("qt_dias_permanencia")
  qtPontos           Int       @map("qt_pontos")
  vlIdadeMinima      Int       @map("vl_idade_minima")
  vlIdadeMaxima      Int       @map("vl_idade_maxima")
  vlSh               Decimal   @map("vl_sh") @db.Decimal(12, 2)
  vlSa               Decimal   @map("vl_sa") @db.Decimal(12, 2)
  vlSp               Decimal   @map("vl_sp") @db.Decimal(12, 2)
  coFinanciamento    String    @map("co_financiamento") @db.VarChar(2)
  coRubrica          String?   @map("co_rubrica") @db.VarChar(6)
  qtTempoPermanencia Int       @map("qt_tempo_permanencia")
  dtCompetencia      String    @map("dt_competencia") @db.Char(6)
  criadoEm           DateTime  @default(now()) @map("criado_em")
  atualizadoEm       DateTime  @updatedAt @map("atualizado_em")
  deletedAt          DateTime? @map("deletado_em")

  // Relação reversa (1:N)
  planosOperativos PlanoOperativoProcedimento[]

  @@index([coFinanciamento])
  @@index([coRubrica])
  @@index([dtCompetencia])
  @@map("sigtap_tb_procedimento")
}

