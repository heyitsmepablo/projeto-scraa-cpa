# ==============================================================================
# SCRAA-CPA - Variáveis de Ambiente e Configuração de Infraestrutura
# ==============================================================================

# ── Identificação da Instância / Namespace Docker Compose ─────────────────────
# Define o prefixo de containers, volumes e redes no docker-compose.yml
COMPOSE_PROJECT_NAME=projeto-scraa

# ── Banco de Dados PostgreSQL 18 ──────────────────────────────────────────────
POSTGRES_DB=scraa
POSTGRES_USER=scraa
POSTGRES_PASSWORD=sua_senha_secreta_aqui
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@database:5432/${POSTGRES_DB}

# ── Portas no Host (docker-compose.yml) ────────────────────────────────────────
DB_PORT=5432
API_PORT=3000
WEB_PORT=80
PGADMIN_PORT=8080

# ── pgAdmin (Profile: tools) ──────────────────────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@scraa.local
PGADMIN_DEFAULT_PASSWORD=admin_password

# ── Sincronização DATASUS (sync_datasus) ───────────────────────────────────────
# Lista de siglas de estados (UFs) separadas por vírgula
DATASUS_UFS=SP,RJ,MG,BA,AM

# ── Sincronização SIGTAP (sync_sigtap) ─────────────────────────────────────────
FTP_HOST=ftp2.datasus.gov.br
FTP_DIR=/pub/sistemas/tup/downloads/
FTP_TIMEOUT=30
SCHEDULE_HOUR=0
SCHEDULE_MINUTE=0

# ── Sincronização Planilhas CPA (sync_cpa_data) ────────────────────────────────
CPA_SPREADSHEET_PATH=/app/arquivos/cpa-data/dados-cpa.xlsx

# ── Logs e Diagnósticos ───────────────────────────────────────────────────────
LOG_LEVEL=INFO