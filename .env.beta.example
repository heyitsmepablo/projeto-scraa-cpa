# ==============================================================================
# SCRAA-CPA - Instância Beta (docker-compose.yml)
# ==============================================================================

# Identificador do projeto (namespace isolado de containers, redes e volumes)
COMPOSE_PROJECT_NAME=beta-projeto-scraa-cpa

# Banco de Dados PostgreSQL 18
POSTGRES_DB=scraa_beta
POSTGRES_USER=scraa_beta_user
POSTGRES_PASSWORD=beta_secure_password_456
DATABASE_URL=postgresql://scraa_beta_user:beta_secure_password_456@database:5432/scraa_beta

# Portas no Host para Instância Beta
DB_PORT=5434
API_PORT=3002
WEB_PORT=8082
PGADMIN_PORT=8086

# pgAdmin (Profile: tools)
PGADMIN_DEFAULT_EMAIL=admin-beta@scraa.local
PGADMIN_DEFAULT_PASSWORD=admin_beta_pass

# Scripts ETL
DATASUS_UFS=SP,RJ,MG,BA,AM
FTP_HOST=ftp2.datasus.gov.br
FTP_DIR=/pub/sistemas/tup/downloads/
FTP_TIMEOUT=30
SCHEDULE_HOUR=2
SCHEDULE_MINUTE=0

# Log
LOG_LEVEL=INFO
